# Copie ce fichier en .streamlit/secrets.toml (jamais commité) ou colle son
# contenu dans « Settings → Secrets » sur Streamlit Community Cloud.
# Toutes les clés sont optionnelles : sans elles, l'app tourne en mode local/démo.

# --- IA Claude (clé API : https://console.anthropic.com/settings/keys) ---
# La facturation API est distincte de l'abonnement claude.ai.
ANTHROPIC_API_KEY = ""
# CLAUDE_MODEL = "claude-opus-5-5"

# --- Garmin Connect ---
# Option 1 (recommandée) : jeton de session, copié depuis la page « Garmin Connect »
# après une première connexion (évite le MFA et les blocages de connexion répétée).
# GARMIN_TOKENS = '{"di_token": "...", "di_refresh_token": "...", "di_client_id": "..."}'
# Option 2 : identifiants (connexion automatique au démarrage, incompatible MFA).
# GARMIN_EMAIL = ""
# GARMIN_PASSWORD = ""

# --- Stockage Google Sheets (sinon : CSV local dans ./data) ---
# SPREADSHEET_NAME = "DB_Dynamic_Hybrid_Coach"
# STORAGE = "local"   # force le mode local même si un compte de service est configuré
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
